[Unit]
Description=Bitcoin Autonomous Lab mainnet node (pruned Bitcoin Core)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=REPLACE_REPO/.local/mainnet/bitcoind.pid
ExecStart=REPLACE_DIST/bitcoin-core-28.1/bin/bitcoind -datadir=REPLACE_REPO/.local/mainnet -daemon
ExecStop=REPLACE_DIST/bitcoin-core-28.1/bin/bitcoin-cli -datadir=REPLACE_REPO/.local/mainnet stop
Restart=always
RestartSec=10
Nice=10
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
