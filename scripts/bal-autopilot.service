[Unit]
Description=Bitcoin Autonomous Lab autopilot (mainnet miner supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/REPLACE_ME/Bitcoin-Autonomous-Lab
ExecStart=/usr/bin/python3 mining/autopilot.py
Restart=always
RestartSec=5
# Self-update is on by default (checks every 15 minutes, smoke
# tested, rolls back on failure). Set to 0 to disable.
Environment=BAL_AUTO_UPDATE=1

[Install]
WantedBy=multi-user.target
