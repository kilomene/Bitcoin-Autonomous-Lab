[Unit]
Description=Bitcoin Autonomous Lab autopilot (mainnet miner supervisor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=REPLACE_REPO
ExecStart=/usr/bin/python3 mining/autopilot.py
Restart=always
RestartSec=5
# Self-update is on by default (checks every 15 minutes, smoke
# tested, rolls back on failure). Set to 0 to disable.
Environment=BAL_AUTO_UPDATE=1
# Worker name defaults to this machine's hostname inside the
# autopilot; set BAL_WORKER here only to override it.
# Environment=BAL_WORKER=my-name

[Install]
WantedBy=multi-user.target
