{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "EXPERIMENT_CLOSURE_LEDGER.schema.json",
 "title": "NOVA SHA-X Stage 9 experiment closure ledger",
 "type": "object",
 "required": [
  "ledger",
  "remote_head",
  "entries",
  "disposition_counts"
 ],
 "properties": {
  "entries": {
   "type": "array",
   "minItems": 109,
   "maxItems": 109,
   "items": {
    "type": "object",
    "required": [
     "id",
     "hypothesis",
     "implementation_location",
     "correctness_evidence",
     "raw_measurement_availability",
     "statistical_method",
     "independently_reproduced",
     "affects_production_path",
     "metric_class",
     "registry_status",
     "disposition",
     "disposition_basis"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9\\-]*$"
     },
     "independently_reproduced": {
      "enum": [
       "yes",
       "no",
       "unknown"
      ]
     },
     "affects_production_path": {
      "type": "boolean"
     },
     "metric_class": {
      "enum": [
       "hash throughput",
       "candidate construction",
       "orchestration",
       "reliability",
       "other"
      ]
     },
     "disposition": {
      "enum": [
       "INTEGRATED",
       "PROVEN_NOT_INTEGRATED",
       "REJECTED",
       "EXPERIMENTAL",
       "UNDER_INVESTIGATION",
       "DEFERRED",
       "INCONCLUSIVE"
      ]
     },
     "known_limitations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "evidence_paths": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "additionalProperties": true
   }
  }
 },
 "additionalProperties": true
}
